<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rodrigo Rocha - Retro Portfolio</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

    body {
      font-family: 'Press Start 2P', cursive;
      background-color: #0d0a00;
      color: var(--crt-color, #ffea70);
      
      line-height: 1.4;
      text-transform: uppercase;
      margin: 0;
      padding: 0;
      text-shadow: 0 0 3px var(--crt-color, #ffea70), 0 0 7px var(--crt-glow, #d4a300);
    }

    .minimal-text {
        font-size: xx-small;
    }

    .navbar {
      background-color: #0d0a00;
      border-bottom: 2px solid var(--crt-color, #ffea70);
    }
    .navbar-brand {
      color: var(--crt-color, #ffea70) !important;
      font-size: 12px;
    }

    .hamburger {
      font-size: 18px;
      padding-left: 5px;
      cursor: pointer;
      margin-right: 10px;
      color: var(--crt-color, #ffea70);
    }

    .login-panel {
      position: absolute;
      top: 10px;
      right: 20px;
      display: flex;
      gap: 5px;
    }
    .login-panel input {
      background: #0d0a00;
      border: 1px solid var(--crt-color, #ffea70);
      color: var(--crt-color, #ffea70);
      font-size: 10px;
      padding: 2px 4px;
      width: 90px;
    }
    .login-panel button {
      background: transparent;
      border: 1px solid var(--crt-color, #ffea70);
      color: var(--crt-color, #ffea70);
      font-size: 10px;
      padding: 2px 6px;
      cursor: pointer;
    }

    .style-toggle {
      font-size: 10px;
      background: transparent;
      border: 1px solid var(--crt-color, #ffea70);
      color: var(--crt-color, #ffea70);
      padding: 2px 6px;
      cursor: pointer;
    }

    .enter-button {
        margin-left: 5px;
    }

    .info-panel {
      position: absolute;
      top: 80px;
      right: 20px;
      width: 240px;
      background-color: #120f00;
      border: 2px solid var(--crt-color, #ffea70);
      padding: 10px;
      box-shadow: inset 0 0 6px var(--crt-color, #ffea70);
    }
    .info-panel h6 {
      font-size: 10px;
      margin-bottom: 4px;
      border-bottom: 1px dashed var(--crt-color, #ffea70);
    }
    .info-panel p {
      margin: 0;
      font-size: 8px;
    }

    .info-panel span {
      margin: 0;
      font-size: 7px;
    }

    .content {
      margin-right: 260px;
      padding: 20px;
    }

    .box {
      background-color: #120f00;
      border: 1px solid var(--crt-color, #ffea70);
      padding: 10px;
      font-size: 11px;
      margin-bottom: 15px;
    }

    .section-title {
      color: var(--crt-color, #ffea70);
      margin: 20px 0 10px;
      font-size: 13px;
      border-bottom: 1px dashed var(--crt-color, #ffea70);
      display: inline-block;
      padding-bottom: 2px;
    }

    footer {
      background-color: #0d0a00;
      color: var(--crt-color, #ffea70);
      text-align: center;
      padding: 10px;
      font-size: 10px;
      border-top: 1px solid var(--crt-color, #ffea70);
    }

    body::after {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      background: repeating-linear-gradient(
        to bottom,
        rgba(255, 234, 112, 0.05),
        rgba(255, 234, 112, 0.05) 1px,
        transparent 2px,
        transparent 3px
      );
    }

    .side-menu {
    height: 100%;
    width: 0; /* começa fechado */
    position: fixed;
    display: none;
    top: 0;
    left: 0;
    background-color: #0d0a00;
    border-right: 2px solid var(--crt-color, #ffea70);
    overflow-x: hidden;
    transition: 0.3s;
    padding-top: 60px; /* espaço abaixo da navbar */
    box-shadow: inset 0 0 8px var(--crt-color, #ffea70);
    z-index: 1000;
  }

  .side-menu a {
    display: block;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 12px;
    color: var(--crt-color, #ffea70);
    border-bottom: 1px solid var(--crt-color, #ffea70);
    transition: 0.2s;
  }

  .side-menu a:hover {
    background-color: #120f00;
    box-shadow: inset 0 0 8px var(--crt-color, #ffea70);
    color: var(--crt-color, #ffea70);
    text-shadow: 0 0 6px var(--crt-color, #ffea70);
  }

  /* botão hamburguer */
  .hamburger {
    font-size: 18px;
    cursor: pointer;
    margin-right: 10px;
    color: var(--crt-color, #ffea70);
    z-index: 1100;
  }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="align-items-center">
      <span class="hamburger" onclick="toggleMenu()">&#9776;</span>
      <div id="sideMenu" class="side-menu">
        <a href="#" onclick="toggleMenu()">Home</a>
        <a href="https://www.linkedin.com/in/r3corp/" onclick="toggleMenu()">Linkedin</a>
        <a href="https://github.com/r3corp" onclick="toggleMenu()">GIT</a>
        <a href="https://github.com/r3corp/BaseCrowProject" onclick="toggleMenu()">GIT - This project</a>
        <a href="http://web.r3corp.net/" onclick="toggleMenu()">Contact</a>
      </div>
      <a class="navbar-brand" href="#">RODRIGO ROCHA</a>
    </div>
  </nav>

  <!-- Login Panel -->
  <div class="login-panel">
    <button class="style-toggle" onclick="toggleStyle()">Toggle Style</button>
    <input type="text" placeholder="User">
    <input type="password" placeholder="Pass">
    <button class="enter-button">Enter</button>
  </div>

  <!-- Style Toggle -->

  <!-- Info Panel -->
  <div class="info-panel">
    <h6>SYSTEM STATUS</h6>
    <p>CPU: {{cpu_usage}}</p>
    <p>MEMORY: {{used_memory}} / {{total_memory}} GB</p>
    <!--
    <p>KERNEL VERSION: {{kernel_version}}</p>
    <p>OS: {{os_name}}</p>
    -->
    <p>UPTIME: {{uptime}}</p>
    <span align="center">These are actual container statistics</span>
  </div>

  <!-- Main content -->
  <div class="content">

    <div class="box">
        <p>This prototye was created using C++ with Crow restfull api with SQLite as database folowing the architectural standars and designs. It runs at a docker container and de development is also using docker and VScode.</p>
        <p> You can se the source code for it at https://github.com/r3corp/BaseCrowProject</p>
    </div>

    <h2 class="section-title">Professional Summary</h2>
    <div class="box">
      <p>Senior Software Engineer with 15+ years in C++ systems, financial platforms, and performance-critical applications. Experienced in system optimization, database integration, legacy migration, and currently focused on Rust and high-frequency trading systems. MSc in Neural Networks, passionate about low-latency architecture and modern trading infra.</p>
    </div>

    <h2 class="section-title">Core Skills</h2>
    <div class="box">
      <p><strong>Languages:</strong> C++, Java, Python, Shell Script, SQL, ...</p>
      <p><strong>Databases:</strong> PostgreSQL, Oracle SQL, Mysql, ...</p>
      <p><strong>Tools:</strong> Git, Linux, Visual Studio Code, AWS, CI/CD, Ansible, Terraform, ...</p>
      <p><strong>Concepts:</strong> Low-Latency Systems, HFT, System Optimization</p>
    </div>

    <h2 class="section-title">Experience</h2>
    <div class="box">
      <p><strong>SS&C Technologies (2022 – Present):</strong> Integration Engineer – Maintained financial risk software, integrated systems, and enhanced C++/Python infra for global markets.</p>
      <p><strong>DevReady (2018 – 2019):</strong> C++ Developer – Built C++ Logstash interfaces, migrated legacy systems, developed Vue.js panels, automated with Ansible.</p>
      <p><strong>Sony (2009 – 2018):</strong> Sr. System Engineer – Delivered broadcast solutions, optimized real-time video systems, boosted windows 7/10 network transfer speeds by 300%.</p>
      <p><strong>Accenture (2007 – 2009):</strong> C++ Developer – Managed telecom backends, reduced ETL import at Oracle from 2 days to 2h.</p>
    </div>

    <h2 class="section-title">Education</h2>
    <div class="box">
      <p>MSc in Artificial Intelligence (Neural Networks), UFRJ (Coppe)</p>
      <p>Postgraduate in Systems Architecture, Infnet</p>
      <p>Postgraduate in Systems Development & Analysis, PUC-RJ</p>
      <p>BSc in Electrical Engineering, Santa Úrsula</p>
    </div>
  </div>

  <footer>
    <p>&copy; 2025 Rodrigo Rocha Portfolio — Retro CRT Simulation</p>
  </footer>

  <script>
    let green = false;
    function toggleStyle() {
      if (!green) {        
        document.body.style.setProperty("--crt-color", "#00ff66");
        document.body.style.setProperty("--crt-glow", "#00aa44");
      } else {
        document.body.style.setProperty("--crt-color", "#ffea70");
        document.body.style.setProperty("--crt-glow", "#d4a300");
      }
      green = !green;
    }

    function toggleMenu() {
      let menu = document.getElementById("sideMenu");
      if (menu.style.width === "200px") {
        menu.style.width = "0";
        menu.style.display = "none";
      } else {
        menu.style.display = "block";
        menu.style.width = "200px"; // largura do menu aberto
      }
    }
  </script>
</body>
</html>





